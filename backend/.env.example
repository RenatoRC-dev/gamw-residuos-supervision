# Copy to .env in backend/ and replace both passwords before starting Compose.
# Local development only. Never commit .env or put credentials in command arguments.
POSTGRES_DB=gamw_residuos_dev
POSTGRES_PASSWORD=replace_with_bootstrap_administrator_password
APP_DB_PASSWORD=replace_with_application_database_password
DB_URL=jdbc:postgresql://localhost:5433/gamw_residuos_dev
DB_USERNAME=gamw_app_dev
DB_PASSWORD=${APP_DB_PASSWORD}
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
