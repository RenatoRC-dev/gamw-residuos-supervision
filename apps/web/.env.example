# Public build-time configuration: never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api
# Opt-in exclusivamente para Vite dev + loopback + backend desarrollo-local. JWT no usa esta cabecera.
VITE_GAMW_DESARROLLO_LOCAL=false
# Development proxy only; production must configure its own /api reverse proxy.
BACKEND_PROXY_TARGET=http://127.0.0.1:8080
# Mapa base (H-06). Vacío en un build de producción = estilo local sin teselas externas y aviso visible; la tabla conserva la evidencia.
# En desarrollo vacío = estilo de demostración de MapLibre (solo comodidad local). Para el GAMW debe configurarse el proveedor
# cartográfico APROBADO por la institución (decisión de despliegue pendiente; no se elige aquí). No usar el servicio de demostración en producción.
VITE_MAP_STYLE_URL=
# Approximate viewport only; not an official municipal boundary or route.
VITE_MAP_LONGITUDE=-63.16
VITE_MAP_LATITUDE=-17.51
VITE_MAP_ZOOM=12
